generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UnitKerja {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(100)

  users   User[]

  @@map("unit_kerja")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(100)

  users              User[]

  @@map("role")
}

model User {
  id            Int     @id @default(autoincrement())
  nama          String  @db.VarChar(255)
  nip           String? @db.VarChar(30)
  jabatan       String? @db.VarChar(255)
  golongan      String? @db.VarChar(20)
  pangkat       String? @db.VarChar(100)
  email         String  @unique @db.VarChar(100)
  password      String  @db.VarChar(255)
  unit_kerja_id Int
  role_id       Int

  unitKerja        UnitKerja          @relation(fields: [unit_kerja_id], references: [id])
  role             Role               @relation(fields: [role_id], references: [id])

  // Relasi baru ke SIM Penugasan
  suratDiajukan     SuratTugas[]        @relation("PengajuTugas")
  suratDitugaskan   SuratTugasPegawai[]
  absensi           Absensi[]

  @@map("users")
}

// ----------------------------------------------------------------------
// MODEL TAMBAHAN SIM PENUGASAN (SURAT TUGAS & ABSENSI)
// ----------------------------------------------------------------------

model SuratTugas {
  id              String   @id @default(uuid())
  nomorSurat      String   @db.VarChar(100)
  uraianKegiatan  String   @db.VarChar(500)
  pengaju_id      Int
  unitKerja       String   @db.VarChar(50)
  tanggalMulai    String   @db.VarChar(20)
  tanggalSelesai  String   @db.VarChar(20)
  tempat          String   @db.VarChar(255)
  koordinatLat    Float?
  koordinatLng    Float?
  deskripsi       String?  @db.Text
  status          String   @db.VarChar(50) // DRAFT, VERIFIKASI_SUBBAGIAN, PERSETUJUAN_PIMPINAN, SURAT_TERBIT, DITOLAK
  linkSurat       String?  @db.VarChar(500)
  biaya           String?  @db.VarChar(100)
  fileFixUrl      String?  @db.VarChar(255)

  pengaju           User                @relation("PengajuTugas", fields: [pengaju_id], references: [id])
  pegawaiDitugaskan SuratTugasPegawai[]

  @@map("surat_tugas")
}

model SuratTugasPegawai {
  id             String     @id @default(uuid())
  surat_tugas_id String
  user_id        Int

  suratTugas     SuratTugas @relation(fields: [surat_tugas_id], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("surat_tugas_pegawai")
}

model Absensi {
  id                   String  @id @default(uuid())
  user_id              Int
  tanggal              String  @db.VarChar(20) // YYYY-MM-DD
  jamMasuk             String  @db.VarChar(10) // HH:mm
  lokasiPresensiMasuk  String  @db.VarChar(255)
  jamKeluar            String? @db.VarChar(10)
  lokasiPresensiKeluar String? @db.VarChar(255)
  status               String  @db.VarChar(50) // HADIR, IZIN, SAKIT, ALFA, TERLAMBAT
  keterangan           String? @db.Text

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("absensi")
}
